{
  "schemaVersion": 1,
  "id": "telep.muse",
  "name": "Muse",
  "version": "1.0.0",
  "author": "telep",
  "license": "MIT",
  "description": "Muse in the bar: click your avatar and the muse.ai chat drops down from the top. Pop it out into a window when you need more room.",
  "preview": "preview.png",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Muse",
    "description": "Your Muse avatar in the bar; click to drop the muse.ai chat down, click again to tuck it away.",
    "category": "AI",
    "aliases": ["muse", "meta"],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "width": 480,
      "heightPercent": 60,
      "avatar": ""
    },
    "schema": [
      {
        "key": "width",
        "type": "integer",
        "label": "Dropdown width (px)",
        "min": 360,
        "max": 1200,
        "step": 20,
        "defaultValue": 480
      },
      {
        "key": "heightPercent",
        "type": "integer",
        "label": "Dropdown height (% of screen)",
        "min": 30,
        "max": 90,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "avatar",
        "type": "string",
        "label": "Avatar image path (empty = bundled)",
        "defaultValue": "",
        "description": "Absolute or ~/ path to a square PNG of your own Muse avatar."
      }
    ]
  }
}
